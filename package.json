{
  "name": "medical-rag-qa-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:backend": "uvicorn backend.main:app --reload --host 0.0.0.0 --port 8000",
    "prod:backend": "uvicorn backend.main:app --host 0.0.0.0 --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:full": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "concurrently \"npm run prod:backend\" \"npm run dev:frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}