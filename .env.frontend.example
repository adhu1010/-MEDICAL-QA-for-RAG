# Frontend Environment Configuration Example
# Copy this file to frontend/.env.local and update values as needed

# Backend API Configuration
# For local development
VITE_API_BASE_URL=http://localhost:8000

# For Docker/Container deployment
# VITE_API_BASE_URL=http://backend:8000

# For production deployment
# VITE_API_BASE_URL=https://api.your-domain.com

# Application Configuration
VITE_APP_NAME=BioGPT RAG QA
VITE_APP_VERSION=1.0.0

# Firebase Configuration (Optional - only needed if using Firebase)
# Note: Firebase config is already in index.html as global variables
# You can override here if needed
# VITE_FIREBASE_API_KEY=your_api_key
# VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_project_id
# VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# Feature Flags
VITE_ENABLE_CHAT_HISTORY=true
VITE_ENABLE_OFFLINE_MODE=false
VITE_ENABLE_DEBUG_MODE=false

# UI Configuration
VITE_THEME=light
VITE_SIDEBAR_DEFAULT_OPEN=true
